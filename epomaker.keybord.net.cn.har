            "mimeType": "application/javascript",
            "text": "\"use strict\";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[249],{61249:function(e){e.exports=JSON.parse('{\"2000\":\"Fireworks\",\"2001\":\"Lights Off\",\"2002\":\"Rotation\",\"2003\":\"Up and Down Waves\",\"2004\":\"Ocean Waves\",\"2005\":\"Breathing\",\"2006\":\"Waves\",\"2007\":\"Spectrum\",\"2008\":\"Ripples\",\"2009\":\"Static\",\"2010\":\"Single Point\",\"2011\":\"Starlight\",\"2012\":\"Fountain\",\"2013\":\"Grid\",\"2014\":\"Piano\",\"2015\":\"Tide\",\"2016\":\"Stairs\",\"2017\":\"Always On Ripples\",\"2018\":\"Raindrops\",\"2019\":\"Preset\",\"2020\":\"Hundred Flowers\",\"2021\":\"Flowing Light\",\"2022\":\"Waveband\",\"2023\":\"Galaxy\",\"3001\":\"Dynamic Key Travel (DKS)\",\"3002\":\"Please select a key to assign, which can have 1-4 different functions based on press or release travel.\",\"3003\":\"Key 1\",\"3004\":\"Cancel\",\"3005\":\"Continue\",\"3006\":\"Close\",\"3007\":\"Set DKS Points\",\"3008\":\"Cancel\",\"3009\":\"Save\",\"3010\":\"Single key implements 2 functions: Hold the key for one, click the key for another.\",\"3011\":\"Hold\",\"3012\":\"Click\",\"3013\":\"Hold Time\",\"3014\":\"Manually adjust the time required to trigger the \\'hold\\' key (default is 200ms)\",\"3015\":\"Tip: If the \\'hold\\' is bound to a modifier key and another key, the hold will trigger immediately unless the other key is also an MT key.\",\"3016\":\"Cancel\",\"3017\":\"Save\",\"3018\":\"Please select a key to assign, and assign different functions for long press and Rapid  click.\",\"3019\":\"Key 1\",\"3020\":\"Continue\",\"3021\":\"Hold/Click (MT)\",\"3022\":\"Key 1\",\"3023\":\"Key 2\",\"3024\":\"Set Trigger Travel\",\"3025\":\"Trigger Travel\",\"3026\":\"Set Sensitivity for Press and Release Independently\",\"3027\":\"Sensitivity\",\"3028\":\"Press Sensitivity\",\"3029\":\"Release Sensitivity\",\"3030\":\"Cancel\",\"3031\":\"Save\",\"3032\":\"Please select two keys to specify, after enabling, the key with deeper press will take priority to trigger. If the press depth is the same, both will trigger simultaneously.\",\"3033\":\"Key 1\",\"3034\":\"Key 2\",\"3035\":\"Continue\",\"3036\":\"Key 1\",\"3037\":\"Key 2\",\"3038\":\"Set Trigger Travel\",\"3039\":\"Trigger Travel\",\"3040\":\"Set Sensitivity for Press and Release Independently\",\"3041\":\"Sensitivity\",\"3042\":\"Press Sensitivity\",\"3043\":\"Release Sensitivity\",\"3044\":\"Priority\",\"3045\":\"Cancel\",\"3046\":\"Save\",\"3047\":\"Please select two keys, after enabling, it will change the key trigger logic based on your settings.\",\"3048\":\"Key 1\",\"3049\":\"Key 2\",\"3050\":\"Cancel\",\"3051\":\"Continue\",\"3052\":\"Last Input Priority\",\"3053\":\"Absolute Priority\",\"3054\":\"Key\",\"3055\":\"Neutral\",\"3093\":\"Direction\",\"3109\":\"Upgrading in Progress, Progress\",\"3110\":\"Resetting in Progress, Progress\",\"3111\":\"Reset Keyboard Data\",\"3112\":\"Cancel\",\"3113\":\"Confirm\",\"3114\":\"Start upgrading, after confirming, enter upgrade mode, requires connecting the upgrade mode device. After upgrade, you need to perform\",\"3115\":\"Key Calibration\",\"3116\":\"Cancel\",\"3117\":\"Start Upgrade\",\"3118\":\"Connect to Boot\",\"3146\":\"Please Select Same Switches\",\"3147\":\"Confirm\",\"3148\":\"Trigger Travel\",\"3149\":\"Travel Dynamics\",\"3150\":\"VARMILO Wants to Connect to HID Device\",\"3151\":\"Connect to Device\",\"3152\":\"Confirm\",\"3153\":\"Cancel\",\"3154\":\"Please Select a Key for Setup\",\"3155\":\"Confirm\",\"3156\":\"Restore factory settings\",\"3157\":\"This action will clear all settings. Are you sure you want to restore factory settings?\",\"3158\":\"Restore only the currently active onboard profile to factory settings.\",\"3159\":\"Restore all onboard profiles to factory settings (all macro settings will also be cleared).\",\"3160\":\"Restore factory settings\",\"3161\":\"cancel\",\"5010\":\"File Content is Empty\",\"5011\":\"Create Configuration 1\",\"5012\":\"- Import\",\"5013\":\"File Processing Error\",\"5014\":\"\",\"10000\":\"Welcome to EPOMAKER WEB DRIVE Control Center\",\"10001\":\"Return to Start Page\",\"10002\":\"Here you can configure your device through the web interface, customize settings without installing drivers\",\"10003\":\"Loading\",\"10004\":\"Connect Device\",\"10005\":\"Key\",\"10006\":\"Trigger\",\"10007\":\"Advanced\",\"10008\":\"Lighting\",\"10009\":\"Key Test\",\"10010\":\"Website\",\"10011\":\"Settings\",\"10221\":\"Horse Racing\",\"10222\":\"Close\",\"10223\":\"Always on\",\"10224\":\"Breathing\",\"10225\":\"Spectrum\",\"10226\":\"Wave\",\"11000\":\"Basic Keys\",\"11001\":\"Special Keys\",\"11002\":\"Multimedia Keys\",\"11003\":\"Lighting Functions\",\"11004\":\"Layout Keys\",\"11005\":\"Mouse Functions\",\"12000\":\"Lighting\",\"12001\":\"Backlight\",\"12002\":\"Effect\",\"12003\":\"Brightness\",\"12004\":\"Speed\",\"12005\":\"Color\",\"12006\":\"Up\",\"12007\":\"Down\",\"12008\":\"Left\",\"12009\":\"Right\",\"12010\":\"Palette\",\"12011\":\"Turn on backlight\",\"12012\":\"Lighting Settings\",\"12013\":\"Light strip settings\",\"12999\":\"Automatically limit the triggering key stroke to avoid accidental, disconnected, or non triggering situations.\",\"13000\":\"Rapid  Trigger\",\"13001\":\"Press\",\"13002\":\"Release\",\"13003\":\"Trigger Insurance\",\"13004\":\"Top Insurance Zone\",\"13005\":\"Bottom Insurance Zone\",\"13006\":\"Full Travel Rapid  Trigger\",\"13007\":\"When enabled, the sensitivity of pressing (triggering) and releasing (resetting) for quick triggering can be customized separately\",\"13008\":\"On: Rapid  Trigger Full Travel Active,Off: Rapid  Trigger Full Travel Inactive.\",\"13009\":\"Trigger Bottom\",\"13010\":\"Force adding a 0.1mm insurance zone at the bottom to reduce missed trigger chances, making the keyboard run more stable.\",\"13011\":\"TTC Magnetic King Switch (3.4mm/750Gs)\",\"13012\":\"Switch\",\"13013\":\"RT mode\",\"13014\":\"Press travel:\",\"13015\":\"Release travel:\",\"13016\":\"Top dead zone:\",\"13017\":\"Bottom dead zone:\",\"13018\":\"Press RT accuracy \",\"13019\":\"Release RT accuracy \",\"13020\":\"Please enable quick trigger first.\",\"13030\":\"Ice jade switch\",\"13031\":\"GATERON Magnetic Jade switch\",\"13032\":\"Magnetic Pro Switch\",\"13040\":\"Aurora axis\",\"13041\":\"Mount Tai GT\",\"13042\":\"Aurora axis V2\",\"14000\":\"Modifier Keys (Only supports Ctrl, Win, Shift, Alt)\",\"14001\":\"Normal Key\",\"14002\":\"Bind Key\",\"14003\":\"Combination Keys (CB)\",\"14004\":\"Cancel\",\"14005\":\"Save\",\"14006\":\"Continue\",\"14007\":\"One-click Trigger for the Combination Key You Want\",\"14008\":\"Combination keys are a combination of one or more modifier keys (e.g., Ctrl, Shift) and a normal key.\",\"14009\":\"Dynamic Key Travel (DKS)\",\"14010\":\"Single key implements 4 functions: You can bind 1 to 4 different functions based on 4 different press levels.\",\"14011\":\"You can choose two methods: click the \\'+\\' pattern to trigger once (only triggers once), or drag the yellow dot over several \\'+\\' patterns to simulate normal keypress behavior. To repeat an action, just return to the original key travel position.\",\"14012\":\"Hold\",\"14013\":\"Click\",\"14014\":\"Hold Time\",\"14015\":\"Reset\",\"14016\":\"Double Effect Click (MT)\",\"14017\":\"Cancel\",\"14018\":\"Save\",\"14019\":\"Continue\",\"14020\":\"Single key implements 2 functions: Hold the key for one, click the key for another.\",\"14021\":\"If the \\'hold\\' is bound to a modifier key and another key, the hold will trigger immediately unless the other key is also a double effect click key.\",\"14022\":\"Key 1\",\"14023\":\"Key 2\",\"14024\":\"Trigger Travel\",\"14025\":\"Priority\",\"14026\":\"Set Sensitivity for Press and Release Independently\",\"14027\":\"Sensitivity\",\"14028\":\"Press Sensitivity\",\"14029\":\"Release Sensitivity\",\"14030\":\"Bind Key\",\"14031\":\"Bind Key\",\"14032\":\"Input Override Priority (SOCD)\",\"14033\":\"Cancel\",\"14034\":\"Save\",\"14035\":\"Continue\",\"14036\":\"Bind two keys to achieve SOCD function.\",\"14037\":\"Monitor the two bound keys in real-time, and execute different input logic based on your chosen input mode priority.\",\"14038\":\"Click the key to toggle continuous trigger on or off. Hold the key for normal trigger behavior. Drag and drop the key to the desired position to bind the toggle switch.\",\"14039\":\"Bind Key\",\"14040\":\"Toggle Switch (TGL)\",\"14041\":\"Cancel\",\"14042\":\"Save\",\"14043\":\"Cancel\",\"14044\":\"Save\",\"14045\":\"Click the key to toggle continuous trigger on or off, hold the key for normal trigger behavior.\",\"14046\":\"Click the key to lock it at the trigger position, release the key for the normal input.\",\"14047\":\"Add Advanced Keys\",\"14048\":\"Dynamic Key Travel (DKS)\",\"14049\":\"Single key implements 2 instructions: Long press and short press to implement two key instructions. Long press binds Fn key to implement layer switch instructions.\",\"14050\":\"Double Effect Click (MT)\",\"14051\":\"Click the key to toggle continuous trigger: Hold the key for normal trigger instructions.\",\"14052\":\"Toggle Switch (TGL)\",\"14053\":\"Rappy Snappy monitors the 2 selected keys and activates whichever key is pressed down further.\",\"14054\":\"Rappy Snappy (RS)\",\"14055\":\"Snappy Tappy (SOCD Cleaning) monitors the 2 selected keys and activates them based on your chosen settings.\",\"14056\":\"Input Override Priority (SOCD)\",\"14057\":\"Combination Keys (CB)\",\"14058\":\"Template Instruction Library\",\"14059\":\"This template instruction library only saves user-simulated advanced key instructions. It does not apply to the current device and will not be saved in the device\\'s onboard storage. The template instruction can be enabled and bound to a key for application in the device.\",\"14060\":\"The activated advanced key\",\"14061\":\"This application instruction library will save the advanced key instructions set by the user. The instructions can be saved as blank templates for later use.\",\"14062\":\"One key for 4 commands: You can bind 1 to 4 commands based on 4 different levels of pressure.\",\"14063\":\"Key 1\",\"14064\":\"Key 2\",\"14065\":\"Trigger Travel Distance\",\"14066\":\"Independently Set Sensitivity for Press and Release\",\"14067\":\"Sensitivity\",\"14068\":\"Press Sensitivity\",\"14069\":\"Release Sensitivity\",\"14070\":\"Key 1\",\"14071\":\"Key 2\",\"14072\":\"Cancel\",\"14073\":\"Save\",\"14074\":\"Continue\",\"14075\":\"Bind Two Keys for the Rappy Snappy Feature.\",\"14076\":\"Rappy Snappy monitors two bound keys and triggers any further key presses. After pressing Key 1, if Key 2 is pressed further than Key 1, Key 2 will trigger immediately. Once Key 2 is released, Key 1 will trigger. When both keys are fully pressed, both will trigger.\",\"14077\":\"Command List\",\"14078\":\"Stop Recording Action\",\"14079\":\"Start Recording Action\",\"14080\":\"Insert Key Command\",\"14081\":\"Insert Text Command\",\"14082\":\"Use Unified Delay\",\"14083\":\"Show Key Pressed/Released\",\"14084\":\"Bind Key\",\"14085\":\"Macro Name\",\"14086\":\"Please Enter Macro Name\",\"14087\":\"Macro Type\",\"14088\":\"Please Select a Key to Bind First\",\"14089\":\"Please Select a Macro Type First\",\"14090\":\"Macro Command\",\"14091\":\"Cancel\",\"14092\":\"Save\",\"14093\":\"Combine multiple commands, tasks, and actions to create complex command sets.\",\"14094\":\"Please record macro command\",\"14095\":\"Modifier keys and regular keys cannot be empty\",\"14096\":\"One click triggering multiple modifier keys combined with a single regular key to form a combination command\",\"14100\":\"Press to output / Release to stop immediately\",\"14101\":\"Specified times\",\"14102\":\"Switch output: click to turn on/off output\",\"14103\":\"Loop times\",\"15000\":\"Creation Successful\",\"15001\":\"Configuration exceeds the maximum number, cannot create new\",\"15002\":\"Cannot delete the last configuration\",\"15003\":\"Deletion Successful\",\"15004\":\"Modification Successful\",\"15005\":\"Configuration name length should be greater than 3, less than 20 characters\",\"15006\":\"Configuration name already exists\",\"15007\":\"Switching Configuration\",\"15008\":\"New\",\"15009\":\"Delete\",\"15010\":\"Rename\",\"15011\":\"Export Configuration File\",\"15012\":\"Import Configuration File\",\"15013\":\"Maximum 5 configurations can be created!\",\"15014\":\"Configuration Import Successful\",\"15015\":\"Please enter the name for the new configuration\",\"15016\":\"Cancel\",\"15017\":\"Create\",\"15018\":\"Delete Configuration\",\"15019\":\"Are you sure to delete the current configuration?\",\"15020\":\"Cancel\",\"15021\":\"Delete\",\"15022\":\"Please enter the new name for the configuration\",\"15023\":\"Cancel\",\"15024\":\"Modify\",\"15025\":\"Cancel\",\"15026\":\"Confirm\",\"15027\":\"Default configuration\",\"15028\":\"Keyboard Profile\",\"16000\":\"Key Test\",\"16001\":\"Reset Key Track\",\"16002\":\"Restore selected keys to default values, are you sure?\",\"16003\":\"Restore all keys to default values, are you sure?\",\"16004\":\"Restore the currently selected key to its default key settings.\",\"16005\":\"Restore all global keys of the current layer to their default settings.\",\"16006\":\"1. Select any key to bind a function.\",\"16007\":\"2. When binding FN layer keys, make sure to set the corresponding FN key, otherwise the FN layer combination keys will not be triggered.\",\"16008\":\"Help Text\",\"16009\":\"Confirm\",\"16010\":\"Start Calibration\",\"16011\":\"Stop Calibration\",\"16012\":\"Current Function\",\"16013\":\"Friendly Reminder: \",\"16014\":\"1. During calibration, please press each key at a steady pace using normal typing force until it fully bottoms out. \",\"16015\":\"2. Keys should be calibrated one by one, and when a key turns blue, its calibration is complete.\",\"16016\":\"3. After finishing, click “Stop Calibration” to exit calibration mode. \",\"16017\":\"4. If any switch has been replaced, please recalibrate the corresponding key to ensure normal operation.\",\"17000\":\"Settings\",\"17001\":\"Current Model\",\"17002\":\"Firmware Version\",\"17003\":\"Update\",\"17004\":\"Report Rate\",\"17005\":\"Key Debounce Level\",\"17006\":\"Close\",\"17007\":\"Low\",\"17008\":\"Medium\",\"17009\":\"High\",\"17010\":\"Disable WIN Key\",\"17011\":\"When enabled, the WIN key is disabled.\",\"17012\":\"Disable ALT+TAB\",\"17013\":\"When enabled, ALT+TAB is disabled.\",\"17014\":\"Disable ALT+F4\",\"17015\":\"When enabled, ALT+F4 is disabled.\",\"17016\":\"Theme\",\"17017\":\"Default\",\"17018\":\"Language\",\"17019\":\"Simplified Chinese\",\"17020\":\"Official Website\",\"17021\":\"Player Community\",\"17022\":\"QQ Group① 922644708\",\"17023\":\"QQ Group② 891637776\",\"17024\":\"Feedback\",\"17025\":\"Firmware Update Log\",\"17026\":\"Fix Known Issues\",\"17027\":\"Factory restoration\",\"17028\":\"Latest version\",\"18000\":\"Game Mode\",\"18001\":\"Competitive Mode\",\"18002\":\"FPS Mode\",\"18003\":\"Traditional Input Mode\",\"18004\":\"Preset-\",\"18005\":\"Driver Version\",\"18006\":\"ArbiterWeb v4.71-beta\",\"18007\":\"You are already on the latest version.\",\"18008\":\"Adaptive Stability\",\"18009\":\"This can resolve issues where certain switches may easily register as double presses or fail to register due to manufacturing tolerances.\",\"18010\":\"Tick Rate\",\"18011\":\"Due to the high speed of USB polling, some computers may fail to recognize or misinterpret key presses. This is especially true in certain games, where if the time interval between key press and release is too short, it may not be registered. The higher the Tick Rate, the lower the probability of such issues.\",\"18012\":\"Different switches have varying levels of stability. The keyboard can reduce double-press issues caused by unstable switches by increasing delay. The higher the anti-bounce level, the higher the delay.\",\"18013\":\"The speed at which the keyboard reads key presses. The higher the value, the faster the reading speed. Increasing the polling rate will increase the system CPU load.\",\"18014\":\"High\",\"18015\":\"Medium\",\"18016\":\"Low\",\"20001\":\"Main Layer\",\"20002\":\"Fn1 Layer\",\"20003\":\"Fn2 Layer\",\"20004\":\"Fn3 Layer\",\"20005\":\"Fn4 Layer\",\"20006\":\"Reset button\",\"20007\":\"Reset all buttons\",\"20010\":\"Shenzhen Arbiter Technology Co., Ltd. \\xa9 2025 Arbiter. Smart Factory.\",\"20011\":\"Guangdong ICP License No. 2022118183-2\",\"20012\":\"Address: Building A, Meisheng Technology Park, Chongqing Road, Fuhai Street, Bao\\'an District, Shenzhen\",\"20013\":\"Email: sally@szarbiter.com\",\"20014\":\"Phone: +86-755-27498301\",\"20015\":\"Guangdong Public Network Security No. 44030002005927\",\"20016\":\"Official Website\",\"20017\":\"Email\",\"20018\":\"Contact Us\",\"20019\":\"Official Store\",\"20106\":\"Left Click\",\"20107\":\"Right Click\",\"20108\":\"Middle Click\",\"20109\":\"Scroll Up\",\"20110\":\"Scroll Down\",\"20111\":\"Forward\",\"20112\":\"Backward\",\"30001\":\"Default\",\"30002\":\"Fn1 Layer\",\"30003\":\"Fn2 Layer\",\"30004\":\"Fn3 Layer\",\"30005\":\"Fn4 Layer\",\"30006\":\"Fn5 Layer\",\"30007\":\"Fn6 Layer\",\"30008\":\"Fn7 Layer\",\"30009\":\"Fn8 Layer\",\"30010\":\"Fn9 Layer\",\"30011\":\"Fn10 Layer\",\"30012\":\"Fn11 Layer\",\"30013\":\"Fn12 Layer\",\"30014\":\"Fn13 Layer\",\"30015\":\"Fn14 Layer\",\"30016\":\"Fn15 Layer\",\"30017\":\"Fn16 Layer\",\"70029\":\"Trigger settings\",\"70030\":\"Switch selection\",\"70031\":\"Select WASD \",\"70032\":\"Select All\",\"70033\":\"Invert Select\",\"70034\":\"Cancel Select\",\"return\":\"return\"}')}}]);"
