            "text": "\"use strict\";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[234],{62234:function(n){n.exports=JSON.parse('{\"2000\":\"烟花\",\"2001\":\"关灯\",\"2002\":\"旋转\",\"2003\":\"上下波浪\",\"2004\":\"海浪\",\"2005\":\"呼吸\",\"2006\":\"波浪\",\"2007\":\"光谱\",\"2008\":\"涟漪\",\"2009\":\"静态\",\"2010\":\"单点\",\"2011\":\"星光\",\"2012\":\"喷泉\",\"2013\":\"宫格\",\"2014\":\"钢琴\",\"2015\":\"潮汐\",\"2016\":\"阶梯\",\"2017\":\"常亮涟漪\",\"2018\":\"落雨\",\"2019\":\"预设\",\"2020\":\"百花\",\"2021\":\"流光\",\"2022\":\"波带\",\"2023\":\"银河\",\"3001\":\"动态键程（DKS）\",\"3002\":\"请选择一个按键指定，可根据按压或松开行程不同，赋予1-4种功能\",\"3003\":\"按键1\",\"3004\":\"取消\",\"3005\":\"继续\",\"3006\":\"关闭\",\"3007\":\"设置 DKS 点数\",\"3008\":\"取消\",\"3009\":\"保存\",\"3010\":\"单个按键实现 2 种功能：按住按键为一种，单击按键为另一种。\",\"3011\":\"按住\",\"3012\":\"单击\",\"3013\":\"按住时间\",\"3014\":\"手动调整触发“按住”键所需的时间（默认为200ms）\",\"3015\":\"提示：如果“按住”绑定的是修饰键与另一个键的组合的话，按住会立即触发。除非另一个键也是MT键。\",\"3016\":\"取消\",\"3017\":\"保存\",\"3018\":\"请选择一个按键指定，可将长按和快速单击赋予不同功能。\",\"3019\":\"按键1\",\"3020\":\"继续\",\"3021\":\"按住/单击（MT）\",\"3022\":\"按键1\",\"3023\":\"按键2\",\"3024\":\"设置触发行程\",\"3025\":\"触发行程\",\"3026\":\"单独设置触发和松开的灵敏度\",\"3027\":\"灵敏度\",\"3028\":\"按下灵敏度\",\"3029\":\"抬起灵敏度\",\"3030\":\"取消\",\"3031\":\"保存\",\"3032\":\"请选择两个按键指定，开启后，将优先触发按压更深的键，当按压行程相同时将同时触发。\",\"3033\":\"按键1\",\"3034\":\"按键2\",\"3035\":\"继续\",\"3036\":\"按键1\",\"3037\":\"按键2\",\"3038\":\"设置触发行程\",\"3039\":\"触发行程\",\"3040\":\"单独设置松开和按下的灵敏度\",\"3041\":\"灵敏度\",\"3042\":\"按下灵敏度\",\"3043\":\"抬起灵敏度\",\"3044\":\"优先级\",\"3045\":\"取消\",\"3046\":\"保存\",\"3047\":\"请选择两个按键，开启后，将根据设置选择，对应改变按键触发逻辑。\",\"3048\":\"按键1\",\"3049\":\"按键2\",\"3050\":\"取消\",\"3051\":\"继续\",\"3052\":\"最后输入优先级\",\"3053\":\"绝对优先级\",\"3054\":\"键\",\"3055\":\"中性\",\"3093\":\"灯效方向\",\"3109\":\"正在升级中，进度\",\"3110\":\"正在重置中，进度\",\"3111\":\"重置键盘数据\",\"3112\":\"取消\",\"3113\":\"确定\",\"3114\":\"开始升级，确认后进入升级模式，需要连接升级模式设备。升级完后需要进行\",\"3115\":\"按键校准\",\"3116\":\"取消\",\"3117\":\"开始升级\",\"3118\":\"连接Boot\",\"3146\":\"请选择相同轴体\",\"3147\":\"确定\",\"3148\":\"触发键程设置\",\"3149\":\"行程动态\",\"3150\":\"VARMILO想要链接到HID设备\",\"3151\":\"连接至设备\",\"3152\":\"确定\",\"3153\":\"取消\",\"3154\":\"请先选择设置按键\",\"3155\":\"确定\",\"3156\":\"恢复出厂设置\",\"3157\":\"该操作将清空所有设置项，是否确认恢复出厂设置？\",\"3158\":\"仅恢复当前生效中的板载配置为出厂设置。\",\"3159\":\"恢复所有板载配置为出厂设置（宏设置也将一并清空）。\",\"3160\":\"恢复出厂\",\"3161\":\"取消\",\"5010\":\"文件内容为空\",\"5011\":\"新建配置1\",\"5012\":\"-导入\",\"5013\":\"文件处理出错\",\"5014\":\"\",\"10000\":\"欢迎使用EPOMAKER WEB DRIVE控制中心\",\"10001\":\"返回启动页\",\"10002\":\"在这里您可以通过网页端口配置您的设备，进行个性化操作设置，无需安装驱动程序\",\"10003\":\"加载中\",\"10004\":\"连接设备\",\"10005\":\"按键设定\",\"10006\":\"触发设置\",\"10007\":\"高级按键\",\"10008\":\"灯光设置\",\"10009\":\"按键测试\",\"10010\":\"官方网站\",\"10011\":\"驱动设置\",\"10221\":\"跑马\",\"10222\":\"关闭\",\"10223\":\"常亮\",\"10224\":\"呼吸\",\"10225\":\"光谱\",\"10226\":\"波浪\",\"11000\":\"基础按键\",\"11001\":\"特殊按键\",\"11002\":\"多媒体键\",\"11003\":\"灯光功能\",\"11004\":\"配列按键\",\"11005\":\"鼠标功能\",\"12000\":\"背光设置\",\"12001\":\"关闭灯光\",\"12002\":\"模式\",\"12003\":\"亮度\",\"12004\":\"变化速度\",\"12005\":\"自定义颜色\",\"12006\":\"上\",\"12007\":\"下\",\"12008\":\"左\",\"12009\":\"右\",\"12010\":\"调色板\",\"12011\":\"开启灯光\",\"12012\":\"灯光设置\",\"12013\":\"灯条设置\",\"12999\":\"自动限制触发键程，以避免误触、断触或不触发的情况发生。 \",\"13000\":\"快速触发\",\"13001\":\"按下(触发)\",\"13002\":\"松开(重置)\",\"13003\":\"死区设置\",\"13004\":\"初始死区\",\"13005\":\"触底死区\",\"13006\":\"连续快速触发\",\"13007\":\"启用时，可以单独自定义快速触发的按下(触发)和松开(重置)的灵敏度。\",\"13008\":\"启用时，快速触发在完全松开按键时才会终止。禁用时，松开按键到轴体触发行程后终止速触发。\",\"13009\":\"触底优化\",\"13010\":\"强制在底部区域增加一个降低断触几率的0.1mm保险区域，使您的键盘更稳定的运行。\",\"13011\":\"环诺轴\",\"13012\":\"触发效果演示\",\"13013\":\"RT模式\",\"13014\":\"按下键程：\",\"13015\":\"抬起键程：\",\"13016\":\"顶部死区：\",\"13017\":\"底部死区：\",\"13018\":\"触发RT精度\",\"13019\":\"松开RT精度\",\"13020\":\"请先启用快速触发\",\"13030\":\"磁玉Pro\",\"13031\":\"磁玉Gaming\",\"13040\":\"极光轴\",\"13041\":\"泰山GT\",\"13042\":\"极光轴V2\",\"14000\":\"修饰键(仅支持Ctrl、Win、Shift、Alt)\",\"14001\":\"普通按键\",\"14002\":\"绑定按键\",\"14003\":\"组合键（CB）\",\"14004\":\"取消\",\"14005\":\"保存\",\"14006\":\"继续\",\"14007\":\"一键触发您想要的组合键\",\"14008\":\"组合键是一个或多个修饰键（例如Ctrl、Shift）和一个普通按键的组合。\",\"14009\":\"动态键程（DKS）\",\"14010\":\"单个按键实现4种功能：您可以根据4种不同的按压程度绑定1至4种功能。\",\"14011\":\"您可以选择两种方式：点击“+“图案实现单次触发（只触发一次），或是拖动黄点跨过数个“+”图案复现正常的按键触发行为。如果您要重复某个动作，只需回到原本键程位置即可继续，不需要完成整个键程设置。\",\"14012\":\"按住\",\"14013\":\"单击\",\"14014\":\"按住时间\",\"14015\":\"重置\",\"14016\":\"双效点击（MT）\",\"14017\":\"取消\",\"14018\":\"保存\",\"14019\":\"继续\",\"14020\":\"单个按键实现 2 种功能：按住按键为一种，单击按键为另一种。\",\"14021\":\"如果“按住”绑定的是修饰键与另一个键的组合的话，按住会立即触发。除非另一个键也是双效点击键。\",\"14022\":\"绑定按键1\",\"14023\":\"绑定按键2\",\"14024\":\"触发行程\",\"14025\":\"优先级\",\"14026\":\"单独设置按下和松开的灵敏度\",\"14027\":\"灵敏度\",\"14028\":\"按下灵敏度\",\"14029\":\"抬起灵敏度\",\"14030\":\"绑定按键\",\"14031\":\"绑定按键\",\"14032\":\"输入覆盖优先级（SOCD）\",\"14033\":\"取消\",\"14034\":\"保存\",\"14035\":\"继续\",\"14036\":\"绑定两个按键以实现SOCD功能。\",\"14037\":\"实时监测两个绑定的按键，并根据您选择的输入模式来实现不同的输入指令逻辑优先级.\",\"14038\":\"单击按键可切换开启或关闭持续触发。按住按键则为正常触发行为。拖放按键到您想要的键位上即可绑定切换开关键。\",\"14039\":\"绑定按键\",\"14040\":\"切换开关（TGL）\",\"14041\":\"取消\",\"14042\":\"保存\",\"14043\":\"取消\",\"14044\":\"保存\",\"14045\":\"单击按键可切换开启或关闭持续触发，按住按键则为正常触发行为。\",\"14046\":\"单击按键相当于锁定按键于触发位置，按住后放开按键则为原本正常的按键输入。\",\"14047\":\"添加高级键\",\"14048\":\"动态键程（DKS）\",\"14049\":\"单个按键实现2种指令：通过长按和短按实现两种按键指令，长按绑定Fn键可实现按压切层指令。\",\"14050\":\"双效点击（MT）\",\"14051\":\"单击按键可开关持续触发：按住按键侧为正常触发指令。\",\"14052\":\"切换开关（TGL）\",\"14053\":\"Rappy Snappy会监测两个选定的按键，并触发按压程度更深的按键。\",\"14054\":\"Rappy Snappy（RS）\",\"14055\":\"实时监测两个绑定的按键，并根据您选择的输入模式来实现不同的输入指令逻辑优先级\",\"14056\":\"输入覆盖优先级（SOCD）\",\"14057\":\"组合键（CB）\",\"14058\":\"模板指令库\",\"14059\":\"此模板指令库只保存用户模拟设置的高级键指令，并不生效于当前设备中，且不会保存在当前设备板载存储中，可将模板指令启用并绑定按键应用于设备中。\",\"14060\":\"已激活的高级键\",\"14061\":\"此应用指令库会保存用户已设置完成的高级键指令，可将指令保存为空白绑定指令模板以供之后使用。\",\"14062\":\"单个按键实现4种指令：您可以根据4种不同的按压程度绑定1-4种指令。\",\"14063\":\"绑定按键1\",\"14064\":\"绑定按键2\",\"14065\":\"触发行程\",\"14066\":\"单独设置松开和按下的灵敏度\",\"14067\":\"灵敏度\",\"14068\":\"按下灵敏度\",\"14069\":\"抬起灵敏度\",\"14070\":\"绑定按键1\",\"14071\":\"绑定按键2\",\"14072\":\"取消\",\"14073\":\"保存\",\"14074\":\"继续\",\"14075\":\"绑定两个按键以实现Rappy Snappy功能。\",\"14076\":\"Rappy Snappy会监测2个绑定的按键，并触发任何进一步按下的按键，当按下按键1后，如果按键2按下的距离超过按键1，按键2将立即触发，一旦松开按键2，按键1将触发，当两个键都被完全按下时，它们都将被触发。\",\"14077\":\"指令列表\",\"14078\":\"停止录制动作\",\"14079\":\"开始录制动作\",\"14080\":\"插入按键指令\",\"14081\":\"插入文本文字\",\"14082\":\"使用统一延迟\",\"14083\":\"显示按键 按下/抬起\",\"14084\":\"绑定按键\",\"14085\":\"宏命名\",\"14086\":\"请输入宏名称\",\"14087\":\"宏类型\",\"14088\":\"请先选择绑定按键\",\"14089\":\"请先选择宏类型\",\"14090\":\"宏指令（Macro）\",\"14091\":\"取消\",\"14092\":\"保存\",\"14093\":\"汇集多个指令、任务、动作，实现复杂的指令集合。\",\"14094\":\"请录制宏命令\",\"14095\":\"修饰键和普通按键不能为空\",\"14096\":\"一键触发多个修饰键与单个常规按键组合成组合指令。\",\"14100\":\"按下输出/释放立即停止\",\"14101\":\"指定次数\",\"14102\":\"开关输出，单击后打开/关闭输出\",\"14103\":\"循环次数\",\"15000\":\"创建成功\",\"15001\":\"配置已超过最大数量，无法新建\",\"15002\":\"无法删除最后的配置\",\"15003\":\"删除成功\",\"15004\":\"修改成功\",\"15005\":\"配置名称长度应大于3，小于20个字符\",\"15006\":\"配置名称已存在\",\"15007\":\"切换配置中\",\"15008\":\"新建\",\"15009\":\"删除\",\"15010\":\"重命名\",\"15011\":\"导出配置文件\",\"15012\":\"导入配置文件\",\"15013\":\"最多创建5个配置！\",\"15014\":\"导入配置成功\",\"15015\":\"请输入新建配置的名称\",\"15016\":\"取消\",\"15017\":\"创建\",\"15018\":\"删除配置\",\"15019\":\"确定删除当前配置?\",\"15020\":\"取消\",\"15021\":\"删除\",\"15022\":\"请输入配置的新名称\",\"15023\":\"取消\",\"15024\":\"修改\",\"15025\":\"取消\",\"15026\":\"确定\",\"15027\":\"默认配置\",\"15028\":\"配置文件\",\"16000\":\"按键测试\",\"16001\":\"重 置 按 键 轨 迹\",\"16002\":\"将选中的按键恢复到默认值，确定？\",\"16003\":\"将全部按键恢复到默认值，确定？\",\"16004\":\"将当前选中的按键还原出厂按键设置。\",\"16005\":\"将当前层的全局按键还原出厂按键设置。\",\"16006\":\"1.选择任意按键来绑定功能。\",\"16007\":\"2.绑定FN层按键时注意设置对应的FN键，否则将无法通过组合键触发对应的FN层组合键功能。\",\"16008\":\"帮助文本\",\"16009\":\"确定\",\"16010\":\"开始校准\",\"16011\":\"停止校准\",\"16012\":\"当前功能\",\"16013\":\"温馨提示：\",\"16014\":\"1、校准时，请以日常使用力度匀速按压按键至完全触底。\",\"16015\":\"2、按键需逐一校准，当对应按键显示为蓝色时，即表示该键校准完成。\",\"16016\":\"3、完成后，点击“停止校准”即可退出校准模式。\",\"16017\":\"4、若更换了轴体，请对对应按键重新校准一次，以确保正常使用。\",\"17000\":\"设置\",\"17001\":\"当前机型\",\"17002\":\"固件版本\",\"17003\":\"检查更新\",\"17004\":\"回报率\",\"17005\":\"防抖等级\",\"17006\":\"关闭\",\"17007\":\"低\",\"17008\":\"中\",\"17009\":\"高\",\"17010\":\"锁定Win\",\"17011\":\"锁定Win键，防止误触意外唤醒弹窗。\",\"17012\":\"锁定Alt+F4\",\"17013\":\"锁定Alt+F4组合键，防止误触意外关闭程序。\",\"17014\":\"锁定Alt+Tab\",\"17015\":\"锁定Alt+Tab组合键，防止误触意外切换程序。\",\"17016\":\"界面主题\",\"17017\":\"默认\",\"17018\":\"界面语言\",\"17019\":\"简体中文\",\"17020\":\"品牌官网\",\"17021\":\"玩家社群\",\"17022\":\"QQ群①群 922644708\",\"17023\":\"QQ群②群 891637776\",\"17024\":\"问题反馈\",\"17025\":\"固件更新日志\",\"17026\":\"修复已知问题\",\"17027\":\"恢复默认\",\"17028\":\"最新版本，无需更新\",\"18000\":\"游戏模式\",\"18001\":\"竞技模式\",\"18002\":\"FPS模式\",\"18003\":\"传统输入模式\",\"18004\":\"预设配置-\",\"18005\":\"驱动版本\",\"18006\":\"EPOMAKERWebv4.71-beta\",\"18007\":\"当前已是最新版本\",\"18008\":\"自适应稳定\",\"18009\":\"可以解决由轴体制造存在公差而造成的某个轴体容易出现断或不般发的问题。\",\"18010\":\"Tick速率\",\"18011\":\"由于高速USB上报动作太快，某些电脑可能无法识到或漏误别。特别在一些游戏中，如果按键技下和释放动作时间的间隔太短，可能不会被响应，Tick速率越高，这种无法识别或漏识别的概率越小。\",\"18012\":\"由于不同的轴体具有不同的稳定性，键盘可以通过增加延时的方法降低由轴体的不稳定带来的双击,防抖等级越高延时越高\",\"18013\":\"键盘读取按键操作的速度，数值越大读取速度越高，提高回报率会增加系统CPU的负担\",\"18014\":\"高\",\"18015\":\"中\",\"18016\":\"低\",\"20001\":\"主层\",\"20002\":\"Fn1层\",\"20003\":\"Fn2层\",\"20004\":\"Fn3层\",\"20005\":\"Fn4层\",\"20006\":\"重置选中按键\",\"20007\":\"重置全部按键\",\"20106\":\"左键\",\"20107\":\"右键\",\"20108\":\"中键\",\"20109\":\"滚轮上滚\",\"20110\":\"滚轮下滚\",\"20111\":\"前进\",\"20112\":\"后退\",\"30001\":\"主层\",\"30002\":\"Fn1层\",\"30003\":\"Fn2层\",\"30004\":\"Fn3层\",\"30005\":\"Fn4层\",\"30006\":\"Fn5层\",\"30007\":\"Fn6层\",\"30008\":\"Fn7层\",\"30009\":\"Fn8层\",\"30010\":\"Fn9层\",\"30011\":\"Fn10层\",\"30012\":\"Fn11层\",\"30013\":\"Fn12层\",\"30014\":\"Fn13层\",\"30015\":\"Fn14层\",\"30016\":\"Fn15层\",\"30017\":\"Fn16层\",\"70029\":\"触发设置\",\"70030\":\"轴体选择\",\"70031\":\"选择WASD按键\",\"70032\":\"选择所有按键\",\"70033\":\"反向选择按键\",\"70034\":\"取消选择按键\",\"return\":\"return\"}')}}]);"
          },
